# Copy this file to .env and edit the values. Never commit .env to Git.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
APP_NAME=Hwawe Lab
SYSTEM_PROMPT=You are Hwawe AI, the research assistant of Hwawe Lab. Answer clearly and accurately, use Markdown when it helps, and say so when you are not sure.
# Only needed if your Ollama server requires a key (e.g. Ollama cloud / reverse proxy)
OLLAMA_API_KEY=
